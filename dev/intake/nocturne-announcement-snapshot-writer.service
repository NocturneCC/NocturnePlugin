[Unit]
Description=Nocturne bounded public announcement snapshot writer
After=local-fs.target

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/bin/python3 -B /usr/local/lib/nocturne-plugin/announcement_snapshot_writer.py --allowed-user=randal
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/srv/projects/api /srv/projects/database /srv/nocturne-plugin /etc/nocturne-plugin -/run/credentials
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
ReadWritePaths=/srv/projects/nocturne-plugin-announcements-public
MemoryMax=64M
TasksMax=8
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
