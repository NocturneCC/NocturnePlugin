[Unit]
Description=Nocturne bounded public announcement snapshot writer
After=local-fs.target

[Service]
Type=simple
User=randal
Group=www-data
ExecStart=/usr/bin/python3 -B /usr/local/lib/nocturne-plugin/announcement_snapshot_writer.py --allowed-user=randal --allowed-group=www-data
UMask=0077
RuntimeDirectory=nocturne-announcement-public
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/srv/projects /srv/nocturne-plugin /etc/nocturne-plugin -/run/credentials
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
BindPaths=/srv/projects/nocturne-plugin-announcements-public:/run/nocturne-announcement-public
ReadWritePaths=/run/nocturne-announcement-public
MemoryMax=64M
TasksMax=8
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
