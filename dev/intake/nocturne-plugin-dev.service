[Unit]
Description=Nocturne isolated plugin test intake
After=network.target
After=nocturne-plugin-writer.service
Requires=nocturne-plugin-writer.service

[Service]
DynamicUser=yes
WorkingDirectory=/srv/projects/nocturne-plugin-intake/dev/intake
Environment=NOCTURNE_INTAKE_STATE=/var/lib/nocturne-plugin-dev
Environment="NOCTURNE_TEST_RSNS=Simons Alt,RoatBefAuJu"
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NOCTURNE_PENDING_SOCKET=/run/nocturne-plugin-writer/pending.sock
ExecStart=/srv/projects/nocturne-plugin-intake/.venv/bin/gunicorn --bind 127.0.0.1:5072 --workers 2 --timeout 10 --limit-request-line 1024 --limit-request-fields 30 --no-control-socket "intake:create_app()"
StateDirectory=nocturne-plugin-dev
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/srv/projects/database
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=160M
TasksMax=32
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
