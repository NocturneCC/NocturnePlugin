[Unit]
Description=Nocturne public Discord emoji mirror synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
WorkingDirectory=/srv/nocturne-plugin/current/dev/intake
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NOCTURNE_EMOJI_PUBLIC_ROOT=/var/lib/nocturne-plugin-emojis/public
EnvironmentFile=-/etc/nocturne-plugin/emoji-sync.conf
LoadCredential=discord-token:/etc/nocturne-plugin/credentials/emoji-sync-token
ExecStart=/srv/nocturne-plugin/emoji-sync-venv/bin/python -B /srv/nocturne-plugin/current/dev/intake/emoji_sync.py --guild-id=${NOCTURNE_DISCORD_GUILD_ID} --output=${NOCTURNE_EMOJI_PUBLIC_ROOT} --token-file=%d/discord-token
StateDirectory=nocturne-plugin-emojis
StateDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=16

