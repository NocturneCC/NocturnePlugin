[Unit]
Description=Nocturne public Discord emoji mirror synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
WorkingDirectory=/srv/nocturne-plugin/current/dev/intake
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NOCTURNE_EMOJI_PUBLIC_ROOT=/var/lib/nocturne-plugin-emojis/public
LoadCredential=emoji-sync-config:/etc/nocturne-plugin/emoji-sync.json
LoadCredential=discord-token:/etc/nocturne-plugin/credentials/emoji-sync-token
ExecStartPre=/srv/nocturne-plugin/venvs/emoji-python3.14-pillow-12.3.0-5c09fb94deb5/bin/python -B /srv/nocturne-plugin/current/dev/intake/emoji_sync.py --initialize-output --output=${NOCTURNE_EMOJI_PUBLIC_ROOT}
ExecStart=/srv/nocturne-plugin/venvs/emoji-python3.14-pillow-12.3.0-5c09fb94deb5/bin/python -B /srv/nocturne-plugin/current/dev/intake/emoji_sync.py --config-file=${CREDENTIALS_DIRECTORY}/emoji-sync-config --output=${NOCTURNE_EMOJI_PUBLIC_ROOT} --token-file=${CREDENTIALS_DIRECTORY}/discord-token
StateDirectory=nocturne-plugin-emojis/public
StateDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=16
