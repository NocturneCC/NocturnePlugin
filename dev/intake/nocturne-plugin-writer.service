[Unit]
Description=Nocturne RuneLite pending submission writer
After=local-fs.target

[Service]
Type=simple
User=randal
Group=www-data
WorkingDirectory=/srv/projects/nocturne-plugin-intake/dev/intake
ExecStart=/srv/projects/nocturne-plugin-intake/.venv/bin/python -B pending_writer.py
RuntimeDirectory=nocturne-plugin-writer
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
ReadWritePaths=/srv/projects/database
MemoryMax=128M
TasksMax=24
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
