[Unit]
Description=Nocturne RuneLite pending submission importer
After=nocturne-plugin-dev.service
Requires=nocturne-plugin-dev.service

[Service]
Type=oneshot
User=randal
Group=www-data
WorkingDirectory=/srv/projects/nocturne-plugin-intake/dev/intake
ExecStart=/srv/projects/nocturne-plugin-intake/.venv/bin/python -B import_pending.py --limit 500 --apply --no-backup
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/nocturne-plugin-dev
ReadWritePaths=/srv/projects/database
MemoryMax=128M
TasksMax=24
